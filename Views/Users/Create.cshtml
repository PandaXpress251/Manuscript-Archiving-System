@model Thesis_Capstone_Archive.Models.User

<form id="createForm" asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <h5 class="text-primary fw-bold mb-3">Create New User</h5>

    <!-- Validation Summary -->
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <!-- ID Number -->
    <div class="mb-3">
        <label asp-for="IDNumber" class="form-label fw-semibold">ID Number</label>
        <input asp-for="IDNumber" class="form-control" placeholder="Enter ID Number" />
        <span asp-validation-for="IDNumber" class="text-danger"></span>
    </div>

    <!-- First Name -->
    <div class="mb-3">
        <label asp-for="FirstName" class="form-label fw-semibold">First Name</label>
        <input asp-for="FirstName" class="form-control" placeholder="Enter first name" />
        <span asp-validation-for="FirstName" class="text-danger"></span>
    </div>

    <!-- Last Name -->
    <div class="mb-3">
        <label asp-for="LastName" class="form-label fw-semibold">Last Name</label>
        <input asp-for="LastName" class="form-control" placeholder="Enter last name" />
        <span asp-validation-for="LastName" class="text-danger"></span>
    </div>

    <!-- Role -->
    <div class="mb-3">
        <label asp-for="Role" class="form-label fw-semibold">User Role</label>
        <select asp-for="Role" class="form-select">
            <option value="">Select Role</option>
            <option value="Admin">Admin</option>
            <option value="User">User</option>
        </select>
        <span asp-validation-for="Role" class="text-danger"></span>
    </div>

    <!-- Buttons -->
    <div class="d-flex justify-content-end gap-2 mt-4">
        <button type="submit" class="btn btn-primary">Create</button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
