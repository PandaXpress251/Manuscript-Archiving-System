@model Thesis_Capstone_Archive.Models.User

@{
    ViewData["Title"] = "User Details";
}

<h2>User Details</h2>

<div>
    <dl class="row">
        <dt class="col-sm-2">ID Number</dt>
        <dd class="col-sm-10">@Model.IDNumber</dd>

        <dt class="col-sm-2">First Name</dt>
        <dd class="col-sm-10">@Model.FirstName</dd>

        <dt class="col-sm-2">Last Name</dt>
        <dd class="col-sm-10">@Model.LastName</dd>

        <dt class="col-sm-2">Role</dt>
        <dd class="col-sm-10">@Model.Role</dd>
    </dl>
</div>

<a asp-action="Index" class="btn btn-secondary">Back to List</a>
