@model IEnumerable<Thesis_Capstone_Archive.Models.User>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Manage Users";
    var users = Model.Select(u => new
    {
        u.Role,
        u.UserID,
        u.IDNumber,
        u.FirstName,
        u.LastName,
       
    }).ToList();
}

<div class="container-fluid p-4">
    <div class="content-wrapper">
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold mb-0" style="color:#003b93;">User Management</h2>
                <p class="text-muted px-2 mb-0">Manage system users and their details</p>
            </div>
            <button type="button" class="btn btn-primary rounded-pill btn-sm d-flex align-items-center"
                    data-bs-toggle="modal" data-bs-target="#CreateModal" onclick="loadCreateModal()">
                <i class="fa fa-user-plus me-2"></i>
                <span>Add User</span>
            </button>
        </div>

        <!-- Filters and Search -->
        <div class="card border-0 rounded-4 shadow-sm mb-4">
            <div class="card-body">
                <div class="row g-3 align-items-center">
                    <div class="col-12 col-md-4">
                        <div class="input-group">
                            <span class="input-group-text border-0 bg-light text-secondary">
                                <i class="fa fa-search"></i>
                            </span>
                            <input type="text" id="searchInput" class="form-control border-0 bg-light"
                                   placeholder="Search users..." />
                        </div>
                    </div>
                    <div class="col-12 col-md-8 d-flex justify-content-md-end align-items-center gap-3">
                        <label class="text-dark mb-0 me-2">Show Entries:</label>
                        <select id="entriesSelect" class="form-select border-0 bg-light" style="width: 80px">
                            <option value="5" selected>5</option>
                            <option value="10">10</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- Users Table -->
        @if (Model != null && users.Count > 0)
        {
            <div class="card border-0 rounded-4 shadow-sm">
                <div class="card-body p-0">
                    <div style="overflow-y: auto; max-height: 455px;">
                        <table class="table mb-0" id="usersTable">
                            <thead class="sticky-top" style="background: #0e387c; color: white;">
                                <tr>
                                    <th class="border-0 px-4 py-3">User ID</th>
                                    <th class="border-0 px-4 py-3">Full Name</th>
                                    <th class="border-0 px-4 py-3">Role</th>
                                    <th class="border-0 px-4 py-3 text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in users)
                                {
                                    <tr>
                                        <td class="px-4 py-3">@user.IDNumber</td>
                                        <td class="px-4 py-3">@user.LastName @user.FirstName</td>
                                        <td class="px-4 py-3">@user.Role</td>
                                        <td class="px-4 py-3">
                                            <div class="d-flex justify-content-center gap-2">
                                                <button class="btn btn-warning rounded-pill btn-sm"
                                                        onclick="loadEditModal('@user.UserID')">
                                                    <i class="fa fa-edit me-1"></i> Update
                                                </button>
                                                <form asp-action="ResetPassword" asp-controller="Users" method="post">
                                                    @Html.AntiForgeryToken()
                                                    @Html.Hidden("id", user.UserID)
                                                    <button type="submit" class="btn btn-danger rounded-pill btn-sm"
                                                            onclick="return confirm('Reset password for @user.IDNumber?');">
                                                        <i class="fa fa-refresh me-1"></i> Reset Password
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-4">
                <div id="tableInfo" class="text-dark"></div>
                <nav aria-label="Page navigation">
                    <ul class="pagination mb-0" id="pagination"></ul>
                </nav>
            </div>
        }
        else
        {
            <div class="card border-0 rounded-4 shadow-sm">
                <div class="card-body p-5 text-center">
                    <i class="fa fa-users fa-3x text-muted opacity-50 mb-4"></i>
                    <h5>No Users Available</h5>
                    <p class="text-muted">Add your first user to get started</p>
                    <button class="btn btn-primary rounded-pill px-4"
                            data-bs-toggle="modal" data-bs-target="#CreateModal" onclick="loadCreateModal()">
                        Add User
                    </button>
                </div>
            </div>
        }
    </div>
</div>

<!-- Create Modal -->
<div class="modal fade" id="CreateModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4">
            <div class="modal-header">
                <h5 class="modal-title">New User</h5>
            </div>
            <div class="modal-body" id="createModalBody">
                <!-- AJAX-loaded content -->
            </div>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="EditModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4">
            <div class="modal-header">
                <h5 class="modal-title">Update User Details</h5>
            </div>
            <div class="modal-body" id="editModalBody">
                <!-- AJAX-loaded content -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        // Load Create Modal
        function loadCreateModal() {
            $('#createModalBody').html('<p class="text-muted">Loading...</p>');
            $.get('/Users/Create', function (result) {
                $('#createModalBody').html(result);
            }).fail(function () {
                $('#createModalBody').html('<p class="text-danger">Failed to load the form. Try again.</p>');
            });
        }

        // Handle Create Form Submission
        $(document).on('submit', '#createForm', function (e) {
            e.preventDefault();
            const saveButton = $(this).find('button[type="submit"]');
            saveButton.prop('disabled', true).html('Saving... <i class="fa fa-spinner fa-spin"></i>');

            const formData = $(this).serialize();

            $.ajax({
                url: '/Users/Create',
                type: 'POST',
                data: formData,
                success: function (response) {
                    if (response.success) {
                        $('#CreateModal').modal('hide');
                        location.reload();
                    } else {
                        $('#createModalBody').html(response);
                        saveButton.prop('disabled', false).html('Create');
                    }
                },
                error: function () {
                    alert('An error occurred. Please try again.');
                    saveButton.prop('disabled', false).html('Create');
                }
            });
        });

        // Load Edit Modal
        function loadEditModal(userId) {
            $('#editModalBody').html('<p class="text-muted">Loading...</p>');
            $.get('/Users/Edit/' + userId, function (result) {
                $('#editModalBody').html(result);
                $('#EditModal').modal('show');
            }).fail(function () {
                $('#editModalBody').html('<p class="text-danger">Failed to load user details.</p>');
            });
        }

        // Handle Edit Form Submission
        $(document).on('submit', '#editForm', function (e) {
            e.preventDefault();
            const $form = $(this);
            const saveBtn = $form.find('button[type="submit"]');

            saveBtn.prop('disabled', true).html('Saving... <i class="fa fa-spinner fa-spin"></i>');

            $.ajax({
                url: '/Users/Edit/' + $form.find('input[name="UserID"]').val(),
                type: 'POST',
                data: $form.serialize(),
                success: function (response) {
                    if (response.success) {
                        $('#EditModal').modal('hide');
                        location.reload();
                    } else {
                        $('#editModalBody').html(response);
                        saveBtn.prop('disabled', false).html('Update');
                    }
                },
                error: function () {
                    alert('An error occurred. Please try again.');
                    saveBtn.prop('disabled', false).html('Update');
                }
            });
        });

        // Search + Pagination Logic
        $(document).ready(function () {
            const $rows = $('#usersTable tbody tr');
            const $pagination = $('#pagination');
            const $tableInfo = $('#tableInfo');
            const $entriesSelect = $('#entriesSelect');
            let currentPage = 1;
            let entriesPerPage = parseInt($entriesSelect.val());
            let filteredRows = $rows;

            function renderTable() {
                const totalEntries = filteredRows.length;
                const totalPages = Math.ceil(totalEntries / entriesPerPage);
                const startIdx = (currentPage - 1) * entriesPerPage;
                const endIdx = Math.min(startIdx + entriesPerPage, totalEntries);

                $rows.hide();
                filteredRows.slice(startIdx, endIdx).show();

                $pagination.empty();
                if (totalPages > 1) {
                    for (let i = 1; i <= totalPages; i++) {
                        $pagination.append(`
                            <li class="page-item ${i === currentPage ? 'active' : ''}">
                                <a class="page-link rounded-circle mx-1" href="#" data-page="${i}">${i}</a>
                            </li>`);
                    }
                }

                $tableInfo.text(totalEntries > 0
                    ? `Showing ${startIdx + 1} to ${endIdx} of ${totalEntries} entries`
                    : 'No entries available');
            }

            $entriesSelect.on('change', function () {
                entriesPerPage = parseInt($(this).val());
                currentPage = 1;
                renderTable();
            });

            $('#searchInput').on('input', function () {
                const query = $(this).val().toLowerCase();
                filteredRows = $rows.filter(function () {
                    return $(this).text().toLowerCase().includes(query);
                });
                currentPage = 1;
                renderTable();
            });

            $pagination.on('click', '.page-link', function (e) {
                e.preventDefault();
                currentPage = parseInt($(this).data('page'));
                renderTable();
            });

            renderTable();
        });
    </script>
}
