@model Thesis_Capstone_Archive.Models.Keyword

<div class="container py-4">
    <div class="card shadow border-0 mx-auto" style="max-width: 500px;">
        <div class="modal-body">
            <form id="editForm" method="post" action="/Keywords/Edit/@Model.KeywordID">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editKeywordID" name="KeywordID" value="@Model.KeywordID">

                <!-- Validation summary at the top for general form validation -->
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <!-- Input field for KeywordName -->
                <div class="mb-3">
                    <label for="editKeywordName" class="form-label fw-bold">Keyword Name</label>
                    <input type="text" id="editKeywordName" name="KeywordName" value="@Model.KeywordName" class="form-control rounded-3 shadow-sm" required aria-labelledby="KeywordName">
                    <span asp-validation-for="KeywordName" class="text-danger"></span>
                </div>

                <!-- Button Group -->
                <div class="d-grid gap-2">
                    <button type="submit" id="saveButton" class="btn btn-primary">
                        Save changes
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                   
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {
            $('#editForm').on('submit', function () {
                const saveButton = $('#saveButton');
                saveButton.prop('disabled', true);
                saveButton.html('Saving... <i class="fa fa-spinner fa-spin"></i>');
            });
        });
    </script>
}
