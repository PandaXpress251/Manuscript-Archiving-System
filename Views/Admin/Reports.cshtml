@model Thesis_Capstone_Archive.Models.ViewModels.AdminDashboardViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Reports Dashboard";
}

<div class="container-fluid px-4 py-5">
    <div class="d-flex justify-content-between align-items-center mb-9">
        <div>
            <h2 class="fw-bold mb-0 " style="color:#003b93;">
                Reports Overview
            </h2>
        </div>
    </div>

    <!-- Stats Overview -->
    <div class="row g-4 mb-4">
        <div class="col-12">
            <div class="card border-0 bg-gradient-primary text-white shadow-sm rounded-4">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <h6 class="text-white-50 mb-2">Total Manuscripts</h6>
                            <h2 class="display-4 mb-0 fw-bold">@Model.TotalManuscriptCount</h2>
                            <p class="mb-0 mt-2 text-white-50">Documents in Archive</p>
                        </div>
                        <div class="d-none d-md-block">
                            <i class="fas fa-book-open fa-4x opacity-25"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Area -->
    <div class="row g-4">
        <!-- Most Viewed Manuscripts -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-transparent border-0 pt-4 pb-0">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h5 class="mb-0">Most Viewed Manuscripts</h5>
                       
                    </div>
                </div>
                <div class="card-body">
                    @if (Model.MostViewedTitles?.Any() == true)
                    {
                        <div class="list-group list-group-flush">
                            @for (int i = 0; i < Model.MostViewedTitles.Count; i++)
                            {
                                <div class="list-group-item border-0 px-0">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="text-break" style="max-width: 100%; white-space: normal;">
                                            @Model.MostViewedTitles[i]
                                        </div>
                                        <span class="badge bg-light text-primary">
                                            <i class="fas fa-eye me-1"></i>
                                            @Model.MostViewedCounts[i]
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-chart-bar fa-3x text-light mb-3"></i>
                            <p class="text-muted">No viewing data available</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Semester Statistics -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-transparent border-0 pt-4 pb-0">
                    <h5 class="mb-3">Semester Statistics</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Reports" method="get" class="mb-4">
                        <div class="input-group">
                            <span class="input-group-text border-0 bg-light">
                                <i class="fas fa-calendar-alt"></i>
                            </span>
                            <select asp-for="SelectedTermID" 
                                    asp-items="@(new SelectList(Model.Terms, "Value", "Text", Model.SelectedTermID))" 
                                    class="form-select border-0 bg-light"
                                    onchange="this.form.submit()">
                                <option value="">Select Term</option>
                            </select>
                        </div>
                    </form>

                    @if (Model.SelectedTermID.HasValue && Model.SelectedTermID.Value > 0)
                    {
                        <div class="text-center py-4">
                            <h2 class="display-4 fw-bold mb-2 text-primary">@Model.SelectedSemesterManuscriptCount</h2>
                            <p class="text-muted mb-0">Manuscripts Uploaded This Term</p>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-calendar fa-3x text-light mb-3"></i>
                            <p class="text-muted">Select a term to view statistics</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

    <style>
        .bg-gradient-primary {
            background: linear-gradient(45deg, #4e73df 0%, #224abe 100%);
        }

        .card {
            transition: transform 0.2s;
        }

        .card:hover {
            transform: translateY(-5px);
        }

        .list-group-item:hover {
            background-color: #f8f9fa;
        }

        .form-select:focus {
            box-shadow: none;
            border-color: #4e73df;
        }

    </style>

