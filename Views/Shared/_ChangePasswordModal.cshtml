<!-- Change Password Modal -->
<div class="modal fade" id="changePasswordModal" tabindex="-1" aria-labelledby="changePasswordModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg rounded-4 border-0">
            <!-- Modal Header -->
            <div class="modal-header text-white rounded-top-4" style="background-color:#003366;">
                <h5 class="modal-title fw-bold" id="changePasswordModalLabel">Change Password</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Modal Body -->
            <div class="modal-body py-4 px-5">
                <div class="text-center mb-4">
                    <i class="fas fa-lock fa-3x text-primary"></i>
                </div>
                <form id="changePasswordForm">
                    <!-- New Password Field -->
                    <div class="mb-3">
                        <label for="newPassword" class="form-label fw-bold">New Password</label>
                        <input type="password" class="form-control rounded-3 shadow-sm" id="newPassword" name="newPassword" placeholder="Enter new password" required>
                    </div>

                    <!-- Confirm Password Field -->
                    <div class="mb-3">
                        <label for="confirmPassword" class="form-label fw-bold">Confirm Password</label>
                        <input type="password" class="form-control rounded-3 shadow-sm" id="confirmPassword" name="confirmPassword" placeholder="Re-enter new password" required>
                        <div class="form-text text-muted">Ensure the passwords match.</div>
                    </div>

                    <!-- Change Password Button -->
                    <button type="submit" class="btn btn-primary rounded-pill w-100 shadow-sm">
                        <i class="fas fa-key me-2"></i>Change Password
                    </button>

                    <!-- Spinner (Hidden by Default) -->
                    <div id="changePasswordSpinner" class="text-center mt-3" style="display: none;">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Processing...</span>
                        </div>
                    </div>
                </form>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer justify-content-center bg-light rounded-bottom-4">
                <small class="text-muted">Keep your password secure and do not share it with anyone.</small>
            </div>
        </div>
    </div>
</div>